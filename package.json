{
  "name": "@designdigitalestefania/ciid-mexico",
  "version": "1.0.0",
  "private": false,
  "description": "MONITOR CIID - Centro Inteligente de Informacion Digital",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Estefania Perez Vazquez",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "api:test": "vitest run tests/api"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
